# Dependencies
node_modules

# Environment / secrets — never commit these
.env
.env.*
!.env.example

# Claude Code local worktrees (must never be committed — break CI checkout)
.claude/worktrees/

# Build output (Netlify builds fresh on deploy)
dist
dist-electron

# Netlify CLI
.netlify

# Supabase CLI local state (linked project ref is not a secret, but it is
# machine-specific metadata that shouldn't live in the public repo)
supabase/.temp

# Editor / OS noise
.DS_Store
*.log

# Debug / scratch experiments — never commit
scratch/
scratch_*
# One-off agent debugging scripts that keep landing in the repo root
rebrand.js
test-script*.js
test_schema.js
test-*.js

# Local data exports / debug dumps — never commit. These are real business
# records (customer names, site addresses, job costs) and the repo is public.
# dump.json was accidentally committed in 4ce0608; keep this list ahead of it.
dump.json
*dump*.json
schedule_debug*.json
*_export.json
*_backup.json

{
  "name": "relay",
  "private": true,
  "version": "1.4.0",
  "description": "Offline-first field service management platform",
  "author": "RELAY Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.js\"",
    "test:watch": "node --test --watch \"src/**/*.test.js\"",
    "test:migrations": "node --test \"supabase/tests/*.test.js\"",
    "electron:dev": "concurrently \"npm run dev -- --no-open\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "concurrently": "^10.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "vite": "^5.4.0",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/material-icons-outlined": "^5.3.0",
    "@supabase/supabase-js": "^2.107.0",
    "dompurify": "^3.4.14",
    "electron-updater": "^6.8.9",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide": "^1.31.0",
    "marked": "^18.0.11",
    "pdfjs-dist": "^4.10.38",
    "sortablejs": "^1.15.6"
  },
  "build": {
    "appId": "com.relay.dispatch",
    "productName": "RELAY Dispatch",
    "publish": [
      {
        "provider": "github",
        "owner": "berneyiscool-debug",
        "repo": "RELAY-Dispatch",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "RELAY Dispatch"
    }
  }
}

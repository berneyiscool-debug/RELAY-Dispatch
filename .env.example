# Copy to .env.local and fill in your Supabase project values (anon key is public).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: browser-side Google Maps key for local-mode maps.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# The AI provider key is server-side only: the `relay-copilot` edge function
# reads it as a Supabase secret, and the eval harness reads it from here. Never
# prefix it with VITE_ - everything VITE_* is compiled into the shipped bundle.
ANTHROPIC_API_KEY=
